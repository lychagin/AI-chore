# Конфигурация MCP-сервера DGraph.
# Скопировать в .env рядом с сервером либо указать путь через DGRAPH_MCP_ENV_FILE.
# Переменные, уже заданные в окружении процесса, имеют приоритет над этим файлом.

# Адрес alpha-ноды (gRPC-порт, не HTTP)
DGRAPH_CONNECT_URL=localhost:9080

# Несколько alpha через запятую — клиент распределит запросы между ними
DGRAPH_ALPHA_ADDRESSES=localhost:9080

# Отладочный вывод клиента в stderr
DGRAPH_DEBUG=false
